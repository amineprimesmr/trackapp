{
  "name": "trackapp",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "setup:local": "node scripts/bootstrap-local-env.mjs",
    "dev": "node scripts/launch-next-dev.mjs --turbo",
    "dev:open": "node scripts/run-dev-open.mjs",
    "dev:3002": "node scripts/launch-next-dev.mjs -p 3002",
    "dev:3002:open": "node scripts/run-dev-open.mjs 3002 /trackapp/accueil",
    "dev:tracker": "node scripts/free-port.mjs 3001 && node scripts/print-dev-tracker-url.mjs 3001 && next dev --hostname 127.0.0.1 -p 3001",
    "dev:turbo": "node scripts/launch-next-dev.mjs --turbo",
    "dev:homebrew-node22": "PATH=/opt/homebrew/opt/node@22/bin:${PATH} node scripts/free-port.mjs 3000 && PATH=/opt/homebrew/opt/node@22/bin:${PATH} next dev --turbo --hostname 127.0.0.1 -p 3000",
    "dev:webpack": "node scripts/launch-next-dev.mjs",
    "clean": "rm -rf .next node_modules/.cache",
    "reset:dev": "bash scripts/dev-reset.sh",
    "dev:fresh": "npm run clean && npm run dev",
    "dev:reset": "npm run reset:dev && npm run dev",
    "build": "node scripts/sync-trackapp-ressources.mjs && next build",
    "sync:ressources": "node scripts/sync-trackapp-ressources.mjs",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "deploy": "npx vercel deploy --yes --scope amines-projects-00de692e --project trackapp.fr",
    "deploy:prod": "npx vercel deploy --prod --yes --scope amines-projects-00de692e --project trackapp.fr",
    "deploy:watch": "node scripts/watch-deploy.mjs",
    "ship": "npm run typecheck && npm run deploy:prod",
    "ship:fast": "npm run deploy:prod",
    "tiktok:compress-demo": "bash scripts/compress-tiktok-demo-video.sh"
  },
  "dependencies": {
    "@stripe/react-stripe-js": "^6.4.0",
    "@stripe/stripe-js": "^9.6.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.105.4",
    "clsx": "^2.1.1",
    "cobe": "^2.0.1",
    "framer-motion": "^12.38.0",
    "next": "^15.5.18",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "stripe": "^22.1.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "chokidar": "^4.0.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "^15.5.18",
    "eslint-plugin-react": "^7.37.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
