# URL canonique du site en production.
# En local, vous pouvez remplacer par http://127.0.0.1:3000 dans `.env.local`.
NEXT_PUBLIC_APP_URL=https://trackapp.fr

# Dev : Sensor Tower bloque souvent 127.0.0.1 (HTTP 429). Par défaut les revenus
# sont récupérés via la prod (trackapp.fr). Mettre TRACKAPP_METRICS_DEV_PROXY=0 pour désactiver.
# TRACKAPP_METRICS_PROXY_ORIGIN=https://www.trackapp.fr

# JWT cookie après paiement — chaîne aléatoire ≥16 caractères (obligatoire en production)
SUBSCRIPTION_SECRET=change-me-to-a-long-random-string

# Stripe — https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# Clé publishable (pk_live_… / pk_test_…) — requise pour Apple Pay + carte in-page
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Stripe — abonnements Trackapp (Billing → Products → Price IDs)
# Mensuel 29 € / mois — utiliser STRIPE_PRICE_ID_TRACKAPP ou STRIPE_PRICE_ID_MONTHLY
STRIPE_PRICE_ID_MONTHLY=
# À vie 59 € (paiement unique one-time) — anciennement STRIPE_PRICE_ID_YEARLY
STRIPE_PRICE_ID_LIFETIME=
# Alias legacy (fallback si STRIPE_PRICE_ID_LIFETIME vide)
# STRIPE_PRICE_ID_YEARLY=

# Webhook endpoint /api/webhooks/stripe — obligatoire pour commissions affiliés
# Événements à activer : checkout.session.completed, invoice.paid, customer.subscription.deleted, charge.refunded
STRIPE_WEBHOOK_SECRET=

# Affiliation : activer Stripe Connect (Express) sur le compte plateforme
# https://dashboard.stripe.com/connect — les affiliés reçoivent leurs virements via Connect

# Coupon Stripe (ex. −40 %) appliqué au checkout abonnement lorsque le filleul a le cookie de parrainage.
# STRIPE_COUPON_ID_REFERRAL_FRIEND=

# Trackapp SaaS — Supabase Auth + espace app (créez le projet puis coller les clés)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Démo locale uniquement : email utilisé par POST /api/dev/trackapp-demo-session (bouton pied de page hors prod)
# TRACKAPP_DEV_DEMO_EMAIL=dev-local@trackapp.invalid

# Whop — checkout Trackapp PRO (landing `/offers`, CTAs « Créer mon app »)
NEXT_PUBLIC_WHOP_CHECKOUT_URL=https://whop.com/checkout/1CBJjhT7KSQdQtPQTJ6O7-hPmU-zY1U-Ivjn-nYLk1kDWua8E/

# Liens Stripe Payment Link (page paiement + fallback)
NEXT_PUBLIC_STRIPE_PAYMENT_LINK_MONTHLY=https://buy.stripe.com/9B64gt8zkfmz94ibccbMQ02
NEXT_PUBLIC_STRIPE_PAYMENT_LINK_LIFETIME=https://buy.stripe.com/cNi4gt7vg3DR4O2eoobMQ03
# Alias legacy : NEXT_PUBLIC_STRIPE_PAYMENT_LINK_YEARLY=

# Bypass paiement temporaire (bouton dev) :
# TRACKAPP_DEV_UNLOCK=1
# NEXT_PUBLIC_TRACKAPP_DEV_UNLOCK=1

# Prix Stripe « débloquer Trackapp » (sinon utilise STRIPE_PRICE_ID_MONTHLY)
STRIPE_PRICE_ID_TRACKAPP=

# Hero visuel modal auth (desktop colonne droite) — URL absolue ou chemin sous /public
# NEXT_PUBLIC_TRACKAPP_AUTH_HERO=https://...

# OAuth Supabase : Google activé ; Apple désactivé côté app.
# Redirect URLs (Authentication → URL Configuration) :
#   https://trackapp.fr/trackapp/auth/callback
#   https://*.vercel.app/trackapp/auth/callback
#   http://127.0.0.1:3000/trackapp/auth/callback
# Site URL : https://trackapp.fr (ou http://127.0.0.1:3000 en local)
# Désactiver « Confirm email » en dev ou activer SUPABASE_SERVICE_ROLE_KEY pour l'activation post-paiement.

# Meta Graph — résolution Page ID Facebook pour le lien Meta Ads Library (view_all_page_id)
# Jeton avec accès pages publiques — ne jamais exposer côté client
META_AD_LIBRARY_ACCESS_TOKEN=
# Optionnel : version Graph (défaut v21.0)
# META_GRAPH_API_VERSION=v21.0

# TikTok organique — Apify MVP (profil officiel -> videos + stats publiques)
APIFY_TOKEN=
# Requis pour valider Instagram/TikTok via la bio (présence officielle quand le site ne liste pas les réseaux).
# Optionnel : actor par défaut conseillé = andok/tiktok-intelligence
# APIFY_TIKTOK_ACTOR_ID=andok/tiktok-intelligence

# Instagram organique — Apify MVP (profil officiel -> posts/Reels + stats publiques)
# Optionnel : actor par défaut conseillé = instagram-scraper/instagram-profile-posts-scraper
# APIFY_INSTAGRAM_ACTOR_ID=instagram-scraper/instagram-profile-posts-scraper

# ─── Présence officielle (site + réseaux + stores) ─────────────────────────
# Optionnel mais recommandé : recherche web OpenAI pour valider les liens officiels
# quand le site officiel ne liste pas tous les réseaux dans son HTML.
# TRACKER_BRAND_OPENAI_MODEL=gpt-4o-mini
# Intelligence concurrentielle (fiche app) — modèle OpenAI avec web_search (défaut = TRACKER_BRAND_OPENAI_MODEL)
# TRACKAPP_COMPETITOR_OPENAI_MODEL=gpt-4o-mini
# AppLAB Studio (création projet + clarification concept) — défaut = chaîne competitor → brand → gpt-4o-mini
# TRACKAPP_APPLAB_OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# Upstash Redis — file d’attente jobs génération image (recommandé prod sur Vercel)
# https://console.upstash.com → créer une DB Redis → REST URL + token
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Modèle conversation atelier Avatar (défaut : haiku rapide ; ex. claude-sonnet-4-20250514)
# ANTHROPIC_STUDIO_MODEL=
# Affichage client du nom du modèle (optionnel, doit coller au modèle API)
# NEXT_PUBLIC_ANTHROPIC_STUDIO_MODEL=

# Anthropic — analyse photo + chats (Character bible, atelier, carrousel)
# https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optionnel : modèle pour le chat « concept carrousel » (sinon ANTHROPIC_STUDIO_MODEL / haiku)
# ANTHROPIC_CAROUSEL_MODEL=claude-sonnet-4-20250514

# Kling AI — génération vidéo officielle (kling-v2-1 Pro)
# https://klingai.com/developer → API Keys → Access Key + Secret Key
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
